# ---- Liara (required for real calls) ----
# Create in console.liara.ir -> API -> new key. Never paste this in chat or commit it.
LIARA_API_TOKEN=
# Optional: team id when working inside a team account
LIARA_TEAM_ID=
# Verified default (CLI constants). Override only if your probe output says otherwise.
LIARA_API_BASE=https://api.liara.ir
LIARA_DNS_BASE=https://dns-service.liara.ir

# ---- LLM (BoxAPI, OpenAI-compatible; hackathon-provided) ----
BOXAPI_API_KEY=
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
# Strong model for planning / diagnosis, small model for routing / summaries.
# Measured with tools/llm_bench.py (Oct 2026): gpt-6-luna and gpt-5.4-mini support tool calling + JSON.
LLM_STRONG_MODEL=gpt-6-luna
LLM_SMALL_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Set to "json" if the chosen model lacks reliable tool calling (see tools/llm_bench.py)
LLM_ACTION_PROTOCOL=tools

# ---- Copilot runtime ----
# "live" talks to Liara. "mock" talks to tools/mock_liara (default for a safe demo).
COPILOT_MODE=mock
MOCK_LIARA_BASE=http://127.0.0.1:8081
COPILOT_DB_PATH=./data/copilot.sqlite
COPILOT_DRY_RUN=false
# Comma-separated list of app names the agent may touch. Empty = any app in the account.
COPILOT_APP_ALLOWLIST=
# Max extra hourly cost (Toman) a single proposal may add without a hard block
COPILOT_COST_GUARD_HOURLY=5000
# Enable T3 guarded actions (delete, ssl disable, downgrade). Off for the MVP.
COPILOT_ENABLE_GUARDED=false
# Path to the `liara` CLI binary (npm i -g @liara/cli)
LIARA_CLI_BIN=liara
# Watcher
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=20
# Coding-agent bridge: command runner (optional). Receives the FixBrief path as $FIX_BRIEF
CODING_AGENT_CMD=
