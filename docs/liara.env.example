# ---- Liara Ops Copilot: environment for deploying the copilot itself on Liara ----
# Upload this in console.liara.ir -> your app -> Environment variables.
# Fill the three REQUIRED values. Never commit a filled copy.

# REQUIRED: Liara API token (console -> API -> new key). Used for every call to api.liara.ir.
LIARA_API_TOKEN=
# Optional: team id if the token belongs to a team and apps live in the team.
LIARA_TEAM_ID=

# REQUIRED: BoxAPI key (hackathon LLM). Without it the copilot still works, but without free chat.
BOXAPI_API_KEY=
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_STRONG_MODEL=gpt-6-luna
LLM_SMALL_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_ACTION_PROTOCOL=tools

# REQUIRED: password for the public web UI (anyone with the URL would otherwise approve actions).
COPILOT_UI_PASSWORD=

# Runtime
COPILOT_MODE=live
LIARA_API_BASE=https://api.liara.ir
LIARA_DNS_BASE=https://dns-service.liara.ir
# Apps the agent may touch, comma separated. Empty = every app in the account.
COPILOT_APP_ALLOWLIST=
# Max extra hourly cost (Toman) one proposal may add
COPILOT_COST_GUARD_HOURLY=5000
# Keep delete / SSL-disable / downgrade off for the demo
COPILOT_ENABLE_GUARDED=false
COPILOT_DRY_RUN=false

# Container paths (match the Dockerfile; mount a Liara disk at /app/data to keep state)
COPILOT_DB_PATH=/app/data/copilot.sqlite
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8000

# Watcher (polls health and metrics; Liara has no webhooks)
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=20
